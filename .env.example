# Base64-закодированный секрет подписи JWT (не короче 32 байт для HS256).
JWT_SECRET_BASE64=

# Email уже зарегистрированного пользователя, которому при старте выдаётся роль
# CLUB_MANAGER. Нужен один раз: дальше заведующий выдаёт роли через API.
CLUB_MANAGER_EMAIL=

# SMTP для писем со сбросом пароля. Без SPRING_MAIL_HOST приложение работает,
# но код печатается в лог вместо отправки (LoggingPasswordResetMailer).
# Значения ниже — локальный Mailpit из docker-compose (веб-интерфейс на http://localhost:8025).
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@wanderingtable.local
